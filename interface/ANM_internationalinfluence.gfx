# Scripted GUI Pie Chart example by Yard1
# Feel free to use in your mods, but give credits to Yard1 (both in code, with comments; and on your download page)

spriteTypes = {
	spriteType = {
		name = "GFX_pie_chart_segment"
		texturefile = "gfx/interface/pie_chart_segment.dds"
		noOfFrames = 4 # change to how many frames you have, index starts at 1
	}
	spriteType = {
		name = "GFX_pie_chart_segment_internationalinfluence"
		texturefile = "gfx/interface/international_pie_chart_segment.dds"
		noOfFrames = 80 # change to how many frames you have, index starts at 1
	}
	spriteType = {
		name = "GFX_anm_softpowerbg"
		texturefile = "gfx/interface/topbar/anm_softpowerbg.dds"
		transparencecheck = yes
	}
	spriteType = {
		name = "GFX_anm_influencethebutton"
		texturefile = "gfx/interface/anm_influencethebutton.dds"
		transparencecheck = yes
	}
	spriteType = {
		name = "GFX_diploactions_anm_background"
		texturefile = "gfx/interface/diploactions_anm_background.dds"
		transparencecheck = yes
	}
}