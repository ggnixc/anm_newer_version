##################################          THERMONUCLEAR WAR                         #############################################
##################################################################################################################################	

	containerWindowType = { 
		name = "ANM_SG_big_event_nuclear_armageddon_custom_window"
		size = { width = 380 height = 128 }
		position = { x=0 y=-210 }
		Orientation = center
		Origo = center
		clipping = no
		show_sound = anm_nucleararnageddon_bigevent ### SOUND EFFECT GOES HERE, MAKE SURE YOU'RE USING SOUND #EFFECT AND NOT SOUND!!!!!

		background = {
			name = "Background"
			quadTextureSprite ="GFX_tiled_window_1b_no_border"
		}

		instantTextBoxType = {
			name = "Title"
			position = { x = -60 y = 20 }
			font = "aldrich_16_outline"
			borderSize = {x = 0 y = 0}
			text = "BE_NUCLEAR_ARMAGEDDON_T" ###### HERE GOES THE TITLE ########
			maxWidth = 500
			maxHeight = 24
			format = centre
		}

		iconType = {
			name ="image"
			spriteType = "GFX_superevent_nuclearwar"
			position = { x= -286 y = -18 }
			Orientation = center
			alwaystransparent = yes
		}

	}

	containerWindowType = {
		name = "ANM_SG_big_event_frame_nuclear_armageddon_custom"
		size = { width = 588 height = 465 }
		position = { x=0 y=0 }
		Orientation = center
		Origo = center
		clipping = no

		background = {
			name = "Background"
